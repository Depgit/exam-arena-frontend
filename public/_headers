# Read by both Netlify and Cloudflare.

# The service worker must never be cached, or a new version can't reach players.
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

# Android checks this file to trust the app with the site (no browser bar).
/.well-known/assetlinks.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache

# Built files have content hashes in their names: safe to cache for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
